{
  "ime": "OpravilaApp",
  "orbitale": [
    {
      "ime": "UpravljanjeOpravil",
      "entiteta": {
        "ime": "Opravilo",
        "zbirka": "tasks",
        "polja": [
          { "ime": "id", "tip": "niz", "obvezno": true, "primarniKljuc": true },
          { "ime": "title", "tip": "niz", "obvezno": true },
          { "ime": "completed", "tip": "logicno" }
        ]
      },
      "znacilnost": [
        {
          "ime": "BrskalnikOpravil",
          "povezanaEntiteta": "Opravilo",
          "strojStanj": {
            "stanja": [
              { "ime": "Aktivno", "zacetno": true },
              { "ime": "Koncano" }
            ],
            "prehodi": [
              {
                "iz": "Aktivno",
                "do": "Koncano",
                "dogodek": "ZAKLJUCI",
                "ucinki": [
                  ["set", "@entity.completed", true]
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
