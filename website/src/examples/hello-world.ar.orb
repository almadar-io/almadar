{
  "اسم": "مرحبا_بالعالم",
  "مدارات": [{
    "اسم": "محيا",
    "كيان": {
      "اسم": "تحية",
      "حقول": [
        { "اسم": "رسالة", "نوع": "نص" },
        { "اسم": "عدد", "نوع": "رقم", "افتراضي": 0 }
      ]
    },
    "سمات": [{
      "اسم": "قابل_للنقر",
      "آلة_حالة": {
        "حالات": [
          { "اسم": "خامل", "أولي": true },
          { "اسم": "مرحب_به" }
        ],
        "انتقالات": [{
          "من": "خامل",
          "حدث": "نقر",
          "إلى": "مرحب_به",
          "تأثيرات": [
            ["تعيين", "@كيان.رسالة", "مرحبا، أيها العالم!"],
            ["تعيين", "@كيان.عدد", ["+", "@كيان.عدد", 1]],
            ["رسم_واجهة", "main", {
              "نوع": "stats-card",
              "العنوان": "@كيان.رسالة",
              "القيمة": "@كيان.عدد"
            }]
          ]
        }]
      }
    }]
  }]
}
