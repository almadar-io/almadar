<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | Almadar</title>
    {{#if description}}
    <meta name="description" content="{{description}}">
    {{/if}}

    <!-- Match Docusaurus fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Docusaurus-matching styles -->
    <style>
        /* === Almadar Brand Colors (from custom.css) === */
        :root {
            --almadar-sand-gold: #c9a227;
            --almadar-sand-gold-light: #e8c547;
            --almadar-midnight: #0f172a;
            --almadar-midnight-light: #1e293b;
            --almadar-midnight-dark: #020617;
            --almadar-teal: #14b8a6;
            --almadar-teal-light: #2dd4bf;
            --almadar-cyan: #06b6d4;
            --almadar-parchment: #f8fafc;
            --almadar-parchment-muted: #94a3b8;
            --almadar-gradient: linear-gradient(135deg, var(--almadar-teal) 0%, var(--almadar-cyan) 100%);

            --ifm-font-family-base: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --ifm-font-family-monospace: "IBM Plex Mono", "Fira Code", SFMono-Regular, Menlo, Monaco, monospace;

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--ifm-font-family-base);
            background: var(--almadar-midnight);
            color: var(--almadar-parchment);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            line-height: 1.6;
        }

        /* === Navbar (matches Docusaurus) === */
        .navbar {
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--almadar-midnight-light);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 100;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
        }

        .navbar__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .navbar__brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--almadar-parchment);
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
        }

        .navbar__logo {
            height: 32px;
            width: 32px;
        }

        .navbar__items {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .navbar__link {
            color: var(--almadar-parchment);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .navbar__link:hover {
            color: var(--almadar-teal-light);
        }

        .navbar__link--active {
            color: var(--almadar-sand-gold);
        }

        /* === Main Layout === */
        .main-wrapper {
            display: flex;
            padding-top: 60px;
            min-height: 100vh;
        }

        /* === Sidebar (matches Docusaurus docs sidebar) === */
        .sidebar {
            width: 280px;
            flex-shrink: 0;
            background: var(--almadar-midnight);
            border-right: 1px solid var(--almadar-midnight-light);
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100vh - 60px);
            overflow-y: auto;
            padding: 1rem 0;
        }

        .sidebar__back {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            margin: 0 0.75rem 0.5rem;
            color: var(--almadar-parchment-muted);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
        }

        .sidebar__back:hover {
            background: rgba(255, 255, 255, 0.03);
            color: var(--almadar-parchment);
        }

        .sidebar__search {
            padding: 0 1rem;
            margin-bottom: 1rem;
        }

        .sidebar__search input {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1px solid var(--almadar-midnight-light);
            border-radius: var(--radius-sm);
            background: var(--almadar-midnight-light);
            color: var(--almadar-parchment);
            font-size: 0.875rem;
            font-family: var(--ifm-font-family-base);
        }

        .sidebar__search input:focus {
            outline: none;
            border-color: var(--almadar-teal);
        }

        .sidebar__search input::placeholder {
            color: var(--almadar-parchment-muted);
        }

        .menu__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .menu__list-item {
            margin: 0;
        }

        .menu__link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            margin: 0 0.75rem;
            color: var(--almadar-parchment-muted);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: var(--radius-sm);
            transition: all 0.15s ease;
        }

        .menu__link:hover {
            background: rgba(255, 255, 255, 0.03);
            color: var(--almadar-parchment);
        }

        .menu__link--active {
            background: rgba(20, 184, 166, 0.1);
            color: var(--almadar-teal-light);
        }

        .menu__link .badge {
            margin-left: auto;
            font-size: 0.7rem;
            padding: 0.15rem 0.4rem;
            background: var(--almadar-midnight-light);
            border-radius: 4px;
            color: var(--almadar-parchment-muted);
        }

        /* === Main Content === */
        .main {
            flex: 1;
            margin-left: 280px;
            padding: 2rem;
            max-width: 900px;
        }

        .main h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--almadar-parchment);
        }

        .main h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 2rem 0 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--almadar-midnight-light);
            color: var(--almadar-parchment);
        }

        .main h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 1.5rem 0 0.75rem;
            color: var(--almadar-parchment);
        }

        .main p {
            color: var(--almadar-parchment-muted);
            margin-bottom: 1rem;
        }

        .main strong {
            color: var(--almadar-parchment);
        }

        /* === Admonitions/Alerts (matches Docusaurus) === */
        .alert {
            padding: 1rem 1.25rem;
            border-radius: var(--radius-md);
            margin-bottom: 1.5rem;
        }

        .alert--info {
            background: rgba(20, 184, 166, 0.1);
            border-left: 4px solid var(--almadar-teal);
        }

        .alert__title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--almadar-teal-light);
        }

        .alert p {
            margin: 0;
            color: var(--almadar-parchment-muted);
        }

        /* === Code blocks === */
        code {
            font-family: var(--ifm-font-family-monospace);
            background: var(--almadar-midnight-light);
            color: var(--almadar-teal-light);
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
            font-size: 0.9em;
        }

        pre {
            background: var(--almadar-midnight-dark) !important;
            padding: 1rem;
            border-radius: var(--radius-sm);
            overflow-x: auto;
            margin: 1rem 0;
        }

        pre code {
            background: none;
            padding: 0;
            color: var(--almadar-parchment);
        }

        /* === Tables === */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
        }

        th, td {
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--almadar-midnight-light);
        }

        th {
            background: var(--almadar-midnight-light);
            font-weight: 600;
            color: var(--almadar-parchment);
        }

        td {
            color: var(--almadar-parchment-muted);
        }

        /* === Module Cards === */
        .module-section {
            margin-bottom: 3rem;
        }

        .operator-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--almadar-midnight-light);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.2s ease;
        }

        .operator-card:hover {
            border-color: var(--almadar-teal);
        }

        .operator-card h4 {
            font-family: var(--ifm-font-family-monospace);
            color: var(--almadar-teal-light);
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .operator-card p {
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }

        .operator-card .meta {
            display: flex;
            gap: 1rem;
            font-size: 0.8rem;
            color: var(--almadar-parchment-muted);
        }

        .operator-card .meta span {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* === Gradient text === */
        .gradient-text {
            background: var(--almadar-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* === Mobile search === */
        .mobile-search {
            display: none;
            margin-bottom: 1.5rem;
        }

        /* === Scrollbar === */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--almadar-midnight-dark);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--almadar-midnight-light);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--almadar-teal);
        }

        /* === Responsive === */
        @media (max-width: 996px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 1.5rem;
                max-width: 100%;
            }

            .mobile-search {
                display: block;
            }

            .navbar__items {
                display: none;
            }
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar__inner">
            <a href="/" class="navbar__brand">
                <svg class="navbar__logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="50" cy="28" rx="16" ry="20" fill="none" stroke="#14b8a6" stroke-width="2" opacity="0.9" />
                    <ellipse cx="50" cy="72" rx="16" ry="20" fill="none" stroke="#14b8a6" stroke-width="2" opacity="0.9" />
                    <ellipse cx="28" cy="50" rx="20" ry="16" fill="none" stroke="#14b8a6" stroke-width="2" opacity="0.9" />
                    <ellipse cx="72" cy="50" rx="20" ry="16" fill="none" stroke="#14b8a6" stroke-width="2" opacity="0.9" />
                    <circle cx="50" cy="50" r="8" fill="#14b8a6" />
                </svg>
                Almadar
            </a>
            <div class="navbar__items">
                <a href="/" class="navbar__link">Home</a>
                <a href="/docs" class="navbar__link navbar__link--active">Docs</a>
                <a href="/docs/downloads/cli" class="navbar__link">Downloads</a>
                <a href="/blog" class="navbar__link">Blog</a>
                <a href="/enterprise" class="navbar__link">Enterprise</a>
            </div>
        </div>
    </nav>

    <!-- Main Layout -->
    <div class="main-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/docs" class="sidebar__back">← Back to Docs</a>

            <div class="sidebar__search">
                <input type="text" id="sidebar-search" placeholder="Search..." autocomplete="off">
            </div>

            <ul class="menu__list" id="sidebar-nav">
                <!-- Populated by JavaScript -->
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main">
            {{{body}}}
        </main>
    </div>

    <script>
        // Mobile menu toggle (if needed)
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const mobileMenu = document.getElementById('mobileMenu');

        if (mobileMenuToggle && mobileMenu) {
            mobileMenuToggle.addEventListener('click', () => {
                mobileMenu.classList.toggle('active');
                mobileMenuToggle.classList.toggle('active');
            });
        }
    </script>
</body>
</html>
