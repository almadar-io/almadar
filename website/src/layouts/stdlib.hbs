<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | Almadar</title>
    {{#if description}}
    <meta name="description" content="{{description}}">
    {{/if}}

    <!-- Match Docusaurus fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Docusaurus-matching styles -->
    <style>
        /* === Almadar Brand Colors (from custom.css) === */
        :root {
            --almadar-sand-gold: #c9a227;
            --almadar-sand-gold-light: #e8c547;
            --almadar-midnight: #0f172a;
            --almadar-midnight-light: #1e293b;
            --almadar-midnight-dark: #020617;
            --almadar-teal: #14b8a6;
            --almadar-teal-light: #2dd4bf;
            --almadar-cyan: #06b6d4;
            --almadar-parchment: #f8fafc;
            --almadar-parchment-muted: #94a3b8;
            --almadar-gradient: linear-gradient(135deg, var(--almadar-teal) 0%, var(--almadar-cyan) 100%);

            --ifm-font-family-base: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --ifm-font-family-monospace: "IBM Plex Mono", "Fira Code", SFMono-Regular, Menlo, Monaco, monospace;

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;

            --doc-sidebar-width: 300px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--ifm-font-family-base);
            background: var(--almadar-midnight);
            color: var(--almadar-parchment);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            line-height: 1.65;
        }

        /* === Navbar (matches Docusaurus exactly) === */
        .navbar {
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--almadar-midnight-light);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 100;
            display: flex;
            align-items: center;
            padding: 0 1rem;
        }

        .navbar__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .navbar__brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--almadar-parchment);
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
        }

        .navbar__logo {
            height: 32px;
            width: 32px;
        }

        .navbar__items {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .navbar__link {
            color: var(--almadar-parchment);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 0.75rem;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
        }

        .navbar__link:hover {
            color: var(--almadar-teal-light);
            background: rgba(255, 255, 255, 0.05);
        }

        .navbar__link--active {
            color: var(--almadar-teal-light);
        }

        /* === Main Layout (matches Docusaurus docs) === */
        .main-wrapper {
            display: flex;
            width: 100%;
            flex: 1 0 auto;
        }

        .docs-wrapper {
            display: flex;
            width: 100%;
            padding-top: 60px;
        }

        /* === Sidebar (matches Docusaurus docs sidebar) === */
        .theme-doc-sidebar-container {
            display: block;
            width: var(--doc-sidebar-width);
            margin-top: 0;
            border-right: 1px solid var(--almadar-midnight-light);
            will-change: width;
            transition: width 0.2s ease;
            clip-path: inset(0);
        }

        .theme-doc-sidebar-menu {
            position: sticky;
            top: 60px;
            height: calc(100vh - 60px);
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0.5rem;
        }

        .sidebar-back {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.75rem;
            margin: 0.5rem;
            color: var(--almadar-parchment-muted);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
        }

        .sidebar-back:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--almadar-parchment);
        }

        .sidebar-search {
            padding: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-search input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--almadar-midnight-light);
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.05);
            color: var(--almadar-parchment);
            font-size: 0.875rem;
            font-family: var(--ifm-font-family-base);
        }

        .sidebar-search input:focus {
            outline: none;
            border-color: var(--almadar-teal);
            background: rgba(20, 184, 166, 0.05);
        }

        .sidebar-search input::placeholder {
            color: var(--almadar-parchment-muted);
        }

        /* Menu styles matching Docusaurus */
        .menu {
            font-weight: 400;
            overflow-x: visible;
            padding: 0.5rem;
        }

        .menu__list {
            list-style: none;
            margin: 0;
            padding-left: 0;
        }

        .menu__list-item {
            margin-top: 0;
        }

        .menu__link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.375rem 0.75rem;
            color: var(--almadar-parchment-muted);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: var(--radius-sm);
            transition: all 0.15s ease;
        }

        .menu__link:hover {
            background: rgba(255, 255, 255, 0.03);
            color: var(--almadar-parchment);
        }

        .menu__link--active {
            background: rgba(20, 184, 166, 0.1);
            color: var(--almadar-teal-light);
        }

        .menu__link .badge {
            font-size: 0.7rem;
            padding: 0.1rem 0.4rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            color: var(--almadar-parchment-muted);
        }

        /* Sidebar section styles (used by JS-generated content) */
        .sidebar-section {
            margin: 0;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.75rem;
            margin: 0.125rem 0.5rem;
            color: var(--almadar-parchment-muted);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: var(--radius-sm);
            transition: all 0.15s ease;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--almadar-parchment);
        }

        .sidebar-link.active {
            background: rgba(20, 184, 166, 0.1);
            color: var(--almadar-teal-light);
        }

        .sidebar-link .icon {
            font-size: 1rem;
            flex-shrink: 0;
            width: 1.25rem;
            text-align: center;
        }

        .sidebar-link .count {
            margin-left: auto;
            font-size: 0.7rem;
            padding: 0.1rem 0.4rem;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 4px;
            color: var(--almadar-parchment-muted);
        }

        /* === Main Content Area === */
        .main {
            flex: 1 1 auto;
            max-width: calc(100% - var(--doc-sidebar-width));
            width: calc(100% - var(--doc-sidebar-width));
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* === Typography === */
        h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--almadar-parchment);
        }

        h1.gradient-text {
            background: var(--almadar-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 2.5rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--almadar-midnight-light);
            color: var(--almadar-parchment);
        }

        h3 {
            font-size: 1.15rem;
            font-weight: 600;
            margin: 1.5rem 0 0.75rem;
            color: var(--almadar-parchment);
        }

        p {
            color: var(--almadar-parchment-muted);
            margin-bottom: 1rem;
        }

        strong {
            color: var(--almadar-parchment);
            font-weight: 600;
        }

        /* === Admonitions/Alerts (matches Docusaurus) === */
        .alert, .info-box {
            padding: 1rem 1.25rem;
            border-radius: var(--radius-md);
            margin-bottom: 1.5rem;
            border-left: 4px solid var(--almadar-teal);
            background: rgba(20, 184, 166, 0.08);
        }

        .alert__title, .info-box-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--almadar-teal-light);
            font-size: 0.9rem;
        }

        .alert p, .info-box p {
            margin: 0;
            font-size: 0.9rem;
        }

        /* === Code blocks === */
        code {
            font-family: var(--ifm-font-family-monospace);
            background: var(--almadar-midnight-light);
            color: var(--almadar-teal-light);
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
            font-size: 0.875em;
        }

        pre {
            background: var(--almadar-midnight-dark) !important;
            padding: 1rem;
            border-radius: var(--radius-sm);
            overflow-x: auto;
            margin: 1rem 0;
            border: 1px solid var(--almadar-midnight-light);
        }

        pre code {
            background: none;
            padding: 0;
            color: var(--almadar-parchment);
        }

        /* === Tables === */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            font-size: 0.9rem;
        }

        th, td {
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--almadar-midnight-light);
        }

        th {
            background: var(--almadar-midnight-light);
            font-weight: 600;
            color: var(--almadar-parchment);
        }

        td {
            color: var(--almadar-parchment-muted);
        }

        /* === Module Cards === */
        .module-section {
            margin-bottom: 3rem;
        }

        .operator-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--almadar-midnight-light);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.2s ease;
        }

        .operator-card:hover {
            border-color: rgba(20, 184, 166, 0.5);
            background: rgba(20, 184, 166, 0.03);
        }

        .operator-card h4 {
            font-family: var(--ifm-font-family-monospace);
            color: var(--almadar-teal-light);
            font-size: 1rem;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .operator-card p {
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }

        .operator-card .meta {
            display: flex;
            gap: 1rem;
            font-size: 0.8rem;
            color: var(--almadar-parchment-muted);
        }

        .operator-card .meta span {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* === Mobile search === */
        .mobile-search {
            display: none;
            margin-bottom: 1.5rem;
        }

        .mobile-search input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--almadar-midnight-light);
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.05);
            color: var(--almadar-parchment);
            font-size: 1rem;
            font-family: var(--ifm-font-family-base);
        }

        /* === Scrollbar === */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--almadar-midnight-light);
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--almadar-teal);
        }

        /* === Responsive === */
        @media (max-width: 996px) {
            .theme-doc-sidebar-container {
                display: none;
            }

            .main {
                max-width: 100%;
                width: 100%;
            }

            .container {
                padding: 1.5rem;
            }

            .mobile-search {
                display: block;
            }

            .navbar__items {
                display: none;
            }
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar__inner">
            <a href="/" class="navbar__brand">
                <img src="/img/almadar-icon-transparent.svg" alt="Almadar" class="navbar__logo">
                Almadar
            </a>
            <div class="navbar__items">
                <a href="/" class="navbar__link">Home</a>
                <a href="/docs" class="navbar__link navbar__link--active">Docs</a>
                <a href="/docs/downloads/cli" class="navbar__link">Downloads</a>
                <a href="/blog" class="navbar__link">Blog</a>
                <a href="/enterprise" class="navbar__link">Enterprise</a>
            </div>
        </div>
    </nav>

    <!-- Main Layout -->
    <div class="main-wrapper">
        <div class="docs-wrapper">
            <!-- Sidebar -->
            <aside class="theme-doc-sidebar-container">
                <div class="theme-doc-sidebar-menu">
                    <a href="/docs" class="sidebar-back">← Back to Docs</a>

                    <div class="sidebar-search">
                        <input type="text" id="sidebar-search" placeholder="Search..." autocomplete="off">
                    </div>

                    <nav class="menu">
                        <ul class="menu__list" id="sidebar-nav">
                            <!-- Populated by JavaScript -->
                        </ul>
                    </nav>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="main">
                <div class="container">
                    {{{body}}}
                </div>
            </main>
        </div>
    </div>
</body>
</html>
