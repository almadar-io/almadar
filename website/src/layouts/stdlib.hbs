<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <link rel="stylesheet" href="{{root}}styles/main.css">
    <style>
        .stdlib-layout {
            display: flex;
            min-height: 100vh;
        }
        .stdlib-sidebar {
            width: 260px;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            border-right: 1px solid var(--border-subtle, #333);
            padding: 1.5rem 1rem;
            background: var(--surface-base, #0d0d1a);
            flex-shrink: 0;
        }
        .stdlib-sidebar .search-box {
            margin-bottom: 1rem;
        }
        .stdlib-sidebar .search-box input {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--border-subtle, #333);
            border-radius: 6px;
            background: var(--surface-elevated, #1a1a2e);
            color: var(--text-primary, #fff);
            font-size: 0.875rem;
        }
        .sidebar-section {
            margin-bottom: 0.25rem;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.5rem;
            border-radius: 4px;
            text-decoration: none;
            color: var(--text-secondary, #ccc);
            font-size: 0.85rem;
            transition: background 0.15s;
        }
        .sidebar-link:hover,
        .sidebar-link.active {
            background: var(--surface-elevated, #1a1a2e);
            color: var(--text-primary, #fff);
        }
        .sidebar-link .count {
            margin-left: auto;
            font-size: 0.7rem;
            color: var(--text-muted, #888);
        }
        .stdlib-main {
            flex: 1;
            padding: 2rem 3rem;
            max-width: 900px;
        }
        @media (max-width: 900px) {
            .stdlib-sidebar {
                display: none;
            }
            .stdlib-main {
                padding: 1.5rem 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="stdlib-layout">
        <aside class="stdlib-sidebar">
            <div class="search-box">
                <input type="text" id="sidebar-search" placeholder="Search...">
            </div>
            <nav id="sidebar-nav"></nav>
        </aside>
        <main class="stdlib-main">
            {{{body}}}
        </main>
    </div>
</body>
</html>
