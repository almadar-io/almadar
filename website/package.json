{
  "name": "@almadar/website",
  "version": "1.0.0",
  "description": "Almadar documentation and marketing website",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run build:legacy && docusaurus build",
    "build:site": "npm run build:legacy && docusaurus build",
    "build:docusaurus": "docusaurus build",
    "build:legacy": "node scripts/build.js",
    "generate-operator-docs": "node scripts/generate-operator-docs.js",
    "generate-std-docs": "node scripts/generate-std-docs.js",
    "storybook": "storybook dev -p 6007",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "dev:main": "cd sites/main && npx docusaurus start --port 3000",
    "dev:orb": "cd sites/orb && npx docusaurus start --port 3001",
    "dev:studio": "cd sites/studio && npx docusaurus start --port 3002",
    "dev:services": "cd sites/services && npx docusaurus start --port 3003",
    "build:main": "cd sites/main && npx docusaurus build",
    "build:orb": "cd sites/orb && npx docusaurus build",
    "build:studio": "cd sites/studio && npx docusaurus build",
    "build:services": "cd sites/services && npx docusaurus build",
    "clean:cache": "rm -rf node_modules/.cache sites/*/.docusaurus",
    "build:all": "npm run clean:cache && npm run build:main && npm run build:orb && npm run build:studio && npm run clean:cache && npm run build:services",
    "serve:main": "cd sites/main && npx docusaurus serve --port 3000",
    "serve:orb": "cd sites/orb && npx docusaurus serve --port 3001",
    "serve:studio": "cd sites/studio && npx docusaurus serve --port 3002",
    "serve:services": "cd sites/services && npx docusaurus serve --port 3003"
  },
  "dependencies": {
    "@almadar/core": "^2.1.3",
    "@almadar/evaluator": "^2.3.1",
    "@almadar/ui": "^2.9.0",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/plugin-google-gtag": "^3.9.2",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@tanstack/react-query": "^5.0.0",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.0",
    "lucide-react": "^0.570.0",
    "postprocessing": "^6.38.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@storybook/addon-links": "^10.2.6",
    "@storybook/addon-themes": "^10.2.6",
    "@storybook/react": "^10.2.6",
    "@storybook/react-vite": "^10.2.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.27.2",
    "handlebars": "^4.7.8",
    "raw-loader": "^4.0.2",
    "storybook": "^10.2.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
